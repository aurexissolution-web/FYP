# Render Dockerfile can copy them without an external download step.
# ml-service/models/*.pt
ml-service/models/*.pth

# Supabase CLI local state
supabase/.temp/

# Flutter / Dart build artifacts
.dart_tool/
build/
*.iml

# Editor/backup files
*.bak
